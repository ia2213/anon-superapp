# AnonSuperApp Environment Variables

# Telegram Bot (optional - for bot interface)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# SearXNG URL (default: local Docker)
SEARXNG_URL=http://localhost:8080

# Tor SOCKS5 Proxy (default: local Docker)
TOR_PROXY=socks5://localhost:9050

# Search timeout in seconds
SEARCH_TIMEOUT=15
